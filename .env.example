# Copy to .env to override defaults. .env is gitignored and must not contain committed secrets.

# local or cloud
FIN_ENVIRONMENT=local

# Directory for the local database and other app data
FIN_DATA_DIR=data

# Optional. When unset, the app uses sqlite:///<FIN_DATA_DIR>/finances.db
# FIN_DATABASE_URL=

# DEBUG, INFO, WARNING, ERROR, or CRITICAL. INFO is the default; DEBUG is never the default.
FIN_LOG_LEVEL=INFO

# The web server's port on 127.0.0.1 (fin web serve). It always binds to loopback only.
FIN_WEB_PORT=8765

# The Mac's Tailscale name, when the site is reached through Tailscale Serve (Phase 20c;
# see docs/remote-access.md). Unset: only localhost is served.
# FIN_WEB_HOSTNAME=mac-studio.tail1234.ts.net

# Optional. Where backups go; when unset, <FIN_DATA_DIR>/backups. See docs/backups.md.
# FIN_BACKUP_DIR=
# How many backups to keep.
FIN_BACKUP_KEEP=14

# Optional. Where fin export writes CSV files; when unset, <FIN_DATA_DIR>/exports.
# FIN_EXPORT_DIR=
